<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:paddingHorizontal="20dp"
    android:paddingTop="20dp"
    android:paddingBottom="36dp">

    <!-- Stage 0: 響鈴畫面 -->
    <LinearLayout
        android:id="@+id/layoutStage0"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="visible">

        <TextView
            android:id="@+id/tvCurrentTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="07:00"
            android:textSize="48sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnDismissAlarm"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="30dp"
            android:layout_marginBottom="16dp"
            android:text="關閉鬧鐘 (進入背誦)"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Stage 1: 背誦倒數畫面 -->
    <LinearLayout
        android:id="@+id/layoutStage1"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvStage1Timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="剩餘背誦時間：120 秒"
            android:textSize="20sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/pbStage1Progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="10dp" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <LinearLayout
                android:id="@+id/containerStudyCards"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

        <Button
            android:id="@+id/btnStartQuizNow"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="8dp"
            android:text="我背好了，直接開始測試"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- Stage 2: 配對測驗畫面 -->
    <LinearLayout
        android:id="@+id/layoutStage2"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvStage2Attempts"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="剩餘挑戰機會：2 次"
            android:textSize="18sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <ScrollView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:paddingEnd="4dp">
                <LinearLayout
                    android:id="@+id/containerPrompts"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>

            <ScrollView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:paddingStart="4dp">
                <LinearLayout
                    android:id="@+id/containerTargets"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>
        </LinearLayout>
    </LinearLayout>

</FrameLayout>